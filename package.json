{
  "name": "sovereign-agent",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.42",
  "publisher": "ertugrul37",
  "icon": "media/logo.png",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/ertugrul37/sovereign-agent#readme",
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/r/ertugrul37.sovereign-agent?label=Rating&color=f59e0b",
      "href": "https://marketplace.visualstudio.com/items?itemName=ertugrul37.sovereign-agent&ssr=false#review-details",
      "description": "Rate Sovereign Agent 5 Stars on VS Code Marketplace"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/i/ertugrul37.sovereign-agent?label=Installs&color=3b82f6",
      "href": "https://marketplace.visualstudio.com/items?itemName=ertugrul37.sovereign-agent",
      "description": "VS Code Marketplace Installs"
    },
    {
      "url": "https://img.shields.io/badge/Privacy-100%25%20Local%20%7C%20Zero%20Telemetry-10b981",
      "href": "https://github.com/ertugrul37/sovereign-agent",
      "description": "100% Local AI & Zero Telemetry"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ertugrul37/sovereign-agent.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/ertugrul37/sovereign-agent/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "local",
    "ollama",
    "llama.cpp",
    "lm studio",
    "privacy",
    "offline",
    "copilot",
    "local-llm",
    "deepseek",
    "qwen",
    "codellama",
    "vllm",
    "jan",
    "gpt4all",
    "localai",
    "coding-assistant",
    "code-completion",
    "mcp",
    "air-gapped",
    "zero-telemetry",
    "open-source",
    "autonomous-agent",
    "lan",
    "chat",
    "assistant",
    "llm",
    "mistral",
    "gemma"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sovereignAgent",
          "title": "%view.container.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sovereignAgent": [
        {
          "type": "webview",
          "id": "sovereignAgent.chat",
          "name": "%view.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "sovereignAgent.newChat",
        "title": "%command.newChat%",
        "icon": "$(add)"
      },
      {
        "command": "sovereignAgent.selectModel",
        "title": "%command.selectModel%",
        "icon": "$(server)"
      },
      {
        "command": "sovereignAgent.selectCompareModel",
        "title": "%command.selectCompareModel%",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "sovereignAgent.stop",
        "title": "%command.stop%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sovereignAgent.undo",
        "title": "%command.undo%",
        "icon": "$(discard)"
      },
      {
        "command": "sovereignAgent.addSelectionToChat",
        "title": "%command.addSelectionToChat%",
        "icon": "$(insert)"
      },
      {
        "command": "sovereignAgent.openSettings",
        "title": "%command.openSettings%",
        "icon": "$(gear)"
      },
      {
        "command": "sovereignAgent.showNetworkPeers",
        "title": "%command.showNetworkPeers%",
        "icon": "$(radio-tower)"
      },
      {
        "command": "sovereignAgent.openFeedback",
        "title": "%command.openFeedback%",
        "icon": "$(info)"
      },
      {
        "command": "sovereignAgent.openPreview",
        "title": "%command.openPreview%",
        "icon": "$(browser)"
      },
      {
        "command": "sovereignAgent.openGraphify",
        "title": "%command.openGraphify%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "sovereignAgent.rateExtension",
        "title": "%command.rateExtension%",
        "icon": "$(star-full)"
      },
      {
        "command": "sovereignAgent.runBenchmark",
        "title": "%command.runBenchmark%",
        "icon": "$(dashboard)"
      },
      {
        "command": "sovereignAgent.runTdd",
        "title": "%command.runTdd%",
        "icon": "$(beaker)"
      },
      {
        "command": "sovereignAgent.exportChat",
        "title": "%command.exportChat%",
        "icon": "$(download)"
      },
      {
        "command": "sovereignAgent.exportChatPdf",
        "title": "%command.exportChatPdf%",
        "icon": "$(file-pdf)"
      },
      {
        "command": "sovereignAgent.selectLanguage",
        "title": "%command.selectLanguage%",
        "icon": "$(globe)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sovereignAgent.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "sovereignAgent.newChat",
          "when": "view == sovereignAgent.chat",
          "group": "navigation@1"
        },
        {
          "command": "sovereignAgent.openGraphify",
          "when": "view == sovereignAgent.chat",
          "group": "navigation@2"
        },
        {
          "command": "sovereignAgent.selectModel",
          "when": "view == sovereignAgent.chat",
          "group": "navigation@3"
        },
        {
          "command": "sovereignAgent.addSelectionToChat",
          "when": "view == sovereignAgent.chat",
          "group": "navigation@3"
        },
        {
          "command": "sovereignAgent.openSettings",
          "when": "view == sovereignAgent.chat",
          "group": "navigation@4"
        },
        {
          "command": "sovereignAgent.undo",
          "when": "view == sovereignAgent.chat",
          "group": "navigation@5"
        },
        {
          "command": "sovereignAgent.exportChat",
          "when": "view == sovereignAgent.chat",
          "group": "navigation@6"
        },
        {
          "command": "sovereignAgent.openFeedback",
          "when": "view == sovereignAgent.chat",
          "group": "navigation@6"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "sovereignAgent.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "lm-studio",
            "llama-cpp",
            "localai",
            "vllm",
            "jan",
            "gpt4all",
            "openai-compatible"
          ],
          "markdownEnumDescriptions": [
            "%config.provider.ollama%",
            "%config.provider.lmStudio%",
            "%config.provider.llamaCpp%",
            "%config.provider.localai%",
            "%config.provider.vllm%",
            "%config.provider.jan%",
            "%config.provider.gpt4all%",
            "%config.provider.openaiCompatible%"
          ],
          "default": "openai-compatible",
          "markdownDescription": "%config.provider%"
        },
        "sovereignAgent.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.baseUrl%"
        },
        "sovereignAgent.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.model%"
        },
        "sovereignAgent.compareModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.compareModel%"
        },
        "sovereignAgent.asrBaseUrl": {
          "type": "string",
          "default": "http://localhost:8000/v1",
          "markdownDescription": "%config.asrBaseUrl%"
        },
        "sovereignAgent.asrModel": {
          "type": "string",
          "default": "nemotron-3.5-asr",
          "markdownDescription": "%config.asrModel%"
        },
        "sovereignAgent.language": {
          "type": "string",
          "enum": [
            "auto",
            "tr",
            "en",
            "de",
            "es",
            "fr",
            "zh",
            "ru",
            "ja",
            "ko",
            "pt",
            "it",
            "ar",
            "nl",
            "pl",
            "hi",
            "az"
          ],
          "markdownEnumDescriptions": [
            "%config.language.auto%",
            "Türkçe (Turkish)",
            "English",
            "Deutsch (German)",
            "Español (Spanish)",
            "Français (French)",
            "中文 (Chinese)",
            "Русский (Russian)",
            "日本語 (Japanese)",
            "한국어 (Korean)",
            "Português (Portuguese)",
            "Italiano (Italian)",
            "العربية (Arabic)",
            "Nederlands (Dutch)",
            "Polski (Polish)",
            "हिन्दी (Hindi)",
            "Azərbaycan (Azerbaijani)"
          ],
          "default": "auto",
          "markdownDescription": "%config.language%"
        },
        "sovereignAgent.userName": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.userName%"
        },
        "sovereignAgent.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "markdownDescription": "%config.temperature%"
        },
        "sovereignAgent.contextLength": {
          "type": "number",
          "default": 8192,
          "minimum": 1024,
          "markdownDescription": "%config.contextLength%"
        },
        "sovereignAgent.maxIterations": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "markdownDescription": "%config.maxIterations%"
        },
        "sovereignAgent.requireWriteApproval": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.requireWriteApproval%"
        },
        "sovereignAgent.requireCommandApproval": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.requireCommandApproval%"
        },
        "sovereignAgent.allowLanHosts": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.allowLanHosts%"
        },
        "sovereignAgent.enableNetworkDiscovery": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.enableNetworkDiscovery%"
        },
        "sovereignAgent.discoveryDisplayName": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.discoveryDisplayName%"
        },
        "sovereignAgent.mcpServers": {
          "type": "string",
          "default": "{}",
          "markdownDescription": "%config.mcpServers%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/tests/*.spec.js\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}
